<Project>

  <!-- 全局构建配置：所有子项目继承 -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS8618;CS8625</NoWarn>

    <!-- 版本统一管理 -->
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <PrismVersion>9.0.537.11130</PrismVersion>
    <SqlSugarVersion>5.1.4.207</SqlSugarVersion>

    <!-- 产品信息 -->
    <Product>逸华餐饮收银</Product>
    <Company>逸华科技</Company>
    <Version>1.0.0</Version>
    <Copyright>Copyright © 2026 逸华科技</Copyright>
  </PropertyGroup>

  <!--
    ============================================================
     发布配置（体积优化）
    ============================================================
    重要：不能用 PublishTrimmed=true
      原因：裁剪会删掉 Prism.Ioc.Internals.ContainerProviderLocator 的构造函数，
            导致 DryIoc 启动时抛 ContainerException 崩溃。
            Avalonia + Prism 大量依赖反射，裁剪不安全。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 只保留中英文资源，其余语言包不打包 -->
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- 关闭 ReadyToRun：体积优先（低配设备用机械硬盘，R2R 收益有限） -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

</Project>
