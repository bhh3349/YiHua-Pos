<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YiHua.Pos.App.ViewModels"
        xmlns:login="clr-namespace:YiHua.Pos.UI.Views.Login;assembly=YiHua.Pos.UI"
        x:Class="YiHua.Pos.App.Views.ShellView"
        x:DataType="vm:ShellViewModel"
        Title="逸华餐饮收银"
        Width="1366" Height="768"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7">

  <Window.Styles>
    <!-- 导航项：已接线正常色，未接线置灰（避免「点了没反应」） -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#1A2233" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EEF4FF" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#E2EBFF" />
    </Style>
  </Window.Styles>

  <Grid>
    <!--
      未登录：显示登录界面。
      ⚠️ 必须直接放 LoginView 并绑 DataContext，不能写成
      <ContentControl Content="{Binding Login}"/> —— ContentControl 需要 DataTemplate
      才能把 ViewModel 映射成 View，没注册模板时它会退化成 ToString()，
      界面上就只显示一行 "YiHua.Pos.UI.ViewModels.Login.LoginViewModel"。
    -->
    <!-- 外层 Panel 保持 Window 的 DataContext，IsVisible 才绑得到 ShellViewModel -->
    <Panel IsVisible="{Binding !IsLoggedIn}">
      <login:LoginView DataContext="{Binding Login}" />
    </Panel>
    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsLoggedIn}">

    <!-- ===== 左侧导航 ===== -->
    <!-- 宽 160：能放下「交接班」不换行，又不挤压点单区商品网格 -->
    <Border Grid.Column="0" Width="160" Background="#FFFFFF"
            BorderBrush="#E4E7EC" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="16,16,16,12">
          <TextBlock Text="逸华收银" FontSize="17" FontWeight="SemiBold"
                     Foreground="#1A2233" />
          <TextBlock Text="YiHua POS" FontSize="11" Foreground="#98A2B3"
                     Margin="0,2,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding NavItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Button Classes="nav"
                        Height="38"
                        Margin="8,1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="12,0"
                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).NavigateCommand}"
                        CommandParameter="{Binding Key}">
                  <TextBlock Text="{Binding Title}" FontSize="14" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="16,12" FontSize="11"
                   Foreground="#98A2B3" Text="v1.0.0" />
      </Grid>
    </Border>

    <!-- ===== 内容区 ===== -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

      <Border Grid.Row="0" Height="48" Background="#FFFFFF"
              BorderBrush="#E4E7EC" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Margin="20,0" Spacing="10"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding Current.Title}" FontSize="16" FontWeight="SemiBold"
                     Foreground="#1A2233" />
          <TextBlock Text="{Binding Current.Hint}" FontSize="13"
                     Foreground="#98A2B3" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 真实页面挂这里 -->
      <Panel Grid.Row="1" Margin="16">
        <ContentControl Content="{Binding Page}" />
        <!-- 页面打不开时给明确提示，空白界面会让商家以为软件坏了 -->
        <Border IsVisible="{Binding PageError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#FEF3F2" BorderBrush="#F04438" BorderThickness="1"
                CornerRadius="8" Padding="20" VerticalAlignment="Top" Margin="0,40,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="页面打开失败" FontSize="15" FontWeight="SemiBold"
                       Foreground="#B42318" />
            <TextBlock Text="{Binding PageError}" FontSize="13"
                       Foreground="#B42318" TextWrapping="Wrap" />
            <TextBlock Text="详细信息已写入日志目录，可在「关于」页导出诊断报告。"
                       FontSize="12" Foreground="#98A2B3" />
          </StackPanel>
        </Border>
      </Panel>

      <!--
        状态栏：结账/退菜/挂单/下架这些操作的结果都在这里说。
        没有它的话，收银员点完「确认结账」屏幕上什么变化都没有，
        只能靠猜「到底成了没有」。
      -->
      <Border Grid.Row="2" Height="34" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
        <TextBlock Text="{Binding StatusMessage}" Margin="20,0" FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Border>
    </Grid>
    </Grid>
  </Grid>
</Window>