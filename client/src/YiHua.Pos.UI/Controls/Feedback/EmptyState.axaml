<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fb="clr-namespace:YiHua.Pos.UI.Controls.Feedback"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             x:Class="YiHua.Pos.UI.Controls.Feedback.EmptyState">
  <StackPanel Spacing="12"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="320">
    <!-- 几何占位：同心圆（非 emoji，非装饰图） -->
    <Border Width="72" Height="72" CornerRadius="36"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
            HorizontalAlignment="Center">
      <Border Width="36" Height="36" CornerRadius="18"
              Background="{DynamicResource DividerBrush}"
              HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=fb:EmptyState}}"
               FontSize="{DynamicResource FontSizeSubtitle}"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimaryBrush}"
               HorizontalAlignment="Center" />
    <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=fb:EmptyState}}"
               FontSize="{DynamicResource FontSizeBody}"
               Foreground="{DynamicResource TextSecondaryBrush}"
               TextWrapping="Wrap"
               TextAlignment="Center"
               HorizontalAlignment="Center" />
    <btn:PosButton Content="{Binding ActionText, RelativeSource={RelativeSource AncestorType=fb:EmptyState}}"
                   Variant="Primary"
                   HorizontalAlignment="Center"
                   Click="OnActionClick" />
  </StackPanel>
</UserControl>
