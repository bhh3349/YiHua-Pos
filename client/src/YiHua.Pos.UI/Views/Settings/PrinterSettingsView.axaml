<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Settings"
             xmlns:svc="clr-namespace:YiHua.Pos.UI.Services.Settings"
             x:Class="YiHua.Pos.UI.Views.Settings.PrinterSettingsView"
             x:DataType="vm:PrinterSettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12" MaxWidth="860">
      <TextBlock Text="打印机管理" FontSize="20" FontWeight="Bold" />
      <TextBlock x:Name="StateText" FontSize="14"
                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

      <!-- 测试打印：最显眼 -->
      <btn:PosButton Content="测试打印（打小票机）" Variant="Primary"
                     Click="OnTestPrint"
                     MinHeight="56" FontSize="18" HorizontalAlignment="Stretch" />
      <TextBlock x:Name="TestMessage" FontSize="14" TextWrapping="Wrap" />

      <TextBlock Text="已配置打印机" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ItemsControl x:Name="ConfiguredList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="svc:PrinterConfigDto">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding DevicePath}" FontSize="13"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding Usage, StringFormat='用途：{0}'}" FontSize="13"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                  <btn:PosButton Content="测试" Variant="Secondary" Click="OnTestConfigured" MinWidth="90" />
                  <btn:PosButton Content="删除" Variant="Danger" Click="OnRemoveConfigured" MinWidth="90" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="发现的设备" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <TextBlock Text="系统里已装好的打印机排在最前。装了驱动就能用，不需要在这里再配一次。"
                 FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
      <ItemsControl x:Name="DiscoveredList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="svc:DiscoveredPrinterDto">
            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6"
                    Padding="10" Margin="0,0,0,4">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" FontSize="14" />
                  <TextBlock Text="{Binding DevicePath}" FontSize="12"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <btn:PosButton Grid.Column="1" Content="添加" Variant="Secondary"
                               Click="OnAddDiscovered" MinWidth="90" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource DangerBrush}"
                 FontSize="14" TextWrapping="Wrap" />
      <btn:PosButton Content="保存打印机配置" Variant="Primary" Click="OnSave"
                     HorizontalAlignment="Left" MinWidth="180" MinHeight="48" />
    </StackPanel>
  </ScrollViewer>
</UserControl>