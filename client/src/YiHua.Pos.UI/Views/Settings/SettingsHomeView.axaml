<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Settings"
             x:Class="YiHua.Pos.UI.Views.Settings.SettingsHomeView"
             x:DataType="vm:SettingsNavigationViewModel">
  <Grid ColumnDefinitions="240,*">
    <!-- 左侧导航 -->
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="8">
        <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Margin="8,8,8,16" />
        <ItemsControl ItemsSource="{Binding Items}" x:Name="NavItems">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsNavItem">
              <Border Padding="12,10" Margin="0,0,0,4" CornerRadius="8"
                      Background="Transparent">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="13"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <!-- 右侧内容 -->
    <ContentControl Grid.Column="1" x:Name="ContentArea" Margin="16" Content="{Binding SelectedPage}" />
  </Grid>
</UserControl>
