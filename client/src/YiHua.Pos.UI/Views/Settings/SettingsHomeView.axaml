<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Settings"
             x:Class="YiHua.Pos.UI.Views.Settings.SettingsHomeView"
             x:DataType="vm:SettingsNavigationViewModel">
  <Grid ColumnDefinitions="240,*">
    <!--
      左侧导航用 ListBox 而不是 ItemsControl：
      ItemsControl 里的 Border 不会响应点击，之前点了没反应，
      商家永远停在「门店信息」，进不去打印机、收银规则。
      ListBox 自带选中态和键盘上下键，触控和键盘都能用。
    -->
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="设置" FontSize="20" FontWeight="Bold" Margin="16,16,16,8" />
        <ListBox Grid.Row="1" x:Name="NavItems"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding Selected}"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="8,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsNavItem">
              <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- 右侧内容 -->
    <ContentControl Grid.Column="1" x:Name="ContentArea" Margin="16" Content="{Binding SelectedPage}" />
  </Grid>
</UserControl>