<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             xmlns:input="clr-namespace:YiHua.Pos.UI.Controls.Input"
             xmlns:disp="clr-namespace:YiHua.Pos.UI.Controls.Display"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Settings"
             x:Class="YiHua.Pos.UI.Views.Settings.NetworkSyncView"
             x:DataType="vm:NetworkSyncViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12" MaxWidth="600">
      <TextBlock Text="网络与同步" FontSize="20" FontWeight="Bold" />
      <TextBlock Text="{Binding StateText}" FontSize="14"
                 Foreground="{DynamicResource TextSecondaryBrush}" />

      <TextBlock Text="服务器地址" FontSize="14" />
      <input:TouchTextBox Text="{Binding ServerAddress}" Watermark="http://192.168.1.100:8000" />
      <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource DangerBrush}"
                 FontSize="14" />

      <!-- 同步状态：颜色 + 文字 -->
      <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="12" Height="12" CornerRadius="6" VerticalAlignment="Center"
                    Background="{DynamicResource SuccessBrush}" />
            <TextBlock Text="已连接" FontSize="16" FontWeight="SemiBold" />
          </StackPanel>
          <disp:KeyValueRow Key="待同步" Value="{Binding PendingCount, StringFormat='{}{0} 笔'}" />
          <disp:KeyValueRow Key="上次同步" Value="{Binding LastSyncTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
          <TextBlock Text="{Binding SyncError}" Foreground="{DynamicResource DangerBrush}"
                     FontSize="14" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <btn:PosButton Content="手动同步" Variant="Primary"
                     HorizontalAlignment="Left" MinWidth="160" MinHeight="48" />
      <btn:PosButton Content="保存" Variant="Secondary"
                     HorizontalAlignment="Left" MinWidth="160" MinHeight="44" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
