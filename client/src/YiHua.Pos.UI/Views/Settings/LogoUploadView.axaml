<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             x:Class="YiHua.Pos.UI.Views.Settings.LogoUploadView">
  <StackPanel Spacing="12" MinWidth="320">
    <TextBlock Text="上传 Logo" FontSize="18" FontWeight="Bold" />
    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8"
            Padding="24" MinHeight="160">
      <TextBlock Text="预览区&#10;（上传后显示效果）" HorizontalAlignment="Center"
                 VerticalAlignment="Center" TextAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </Border>
    <TextBlock Text="支持 PNG/JPG，自动压缩到 200KB 以内" FontSize="14"
               Foreground="{DynamicResource TextSecondaryBrush}" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <btn:PosButton Grid.Column="0" Content="选择图片" Variant="Secondary" />
      <btn:PosButton Grid.Column="1" Content="确定" Variant="Primary" />
    </Grid>
  </StackPanel>
</UserControl>
