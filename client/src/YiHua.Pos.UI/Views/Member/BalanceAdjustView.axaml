<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             xmlns:input="clr-namespace:YiHua.Pos.UI.Controls.Input"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Member"
             xmlns:svc="clr-namespace:YiHua.Pos.UI.Services.Member"
             x:Class="YiHua.Pos.UI.Views.Member.BalanceAdjustView"
             x:DataType="vm:BalanceAdjustViewModel">
  <StackPanel Spacing="12" MaxWidth="480" Margin="16">
    <TextBlock Text="调整余额" FontSize="20" FontWeight="Bold" />
    <TextBlock Text="客人投诉补偿、点单点错纠错，都在这里调" FontSize="14"
               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

    <TextBlock Text="调整金额（正数=加，负数=减，比如 +10 / -5）" FontSize="14" />
    <input:TouchTextBox Text="{Binding Delta}" Watermark="比如：10 或 -5" />

    <TextBlock Text="原因（必填）" FontSize="14" />
    <ComboBox MinHeight="48" HorizontalAlignment="Stretch">
      <ComboBoxItem>赠送</ComboBoxItem>
      <ComboBoxItem>补偿（客人投诉）</ComboBoxItem>
      <ComboBoxItem>纠错（点单点错）</ComboBoxItem>
      <ComboBoxItem>其他</ComboBoxItem>
    </ComboBox>

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
               FontSize="14" TextWrapping="Wrap" />
    <btn:PosButton Content="确认调整" Variant="Primary" MinHeight="52" HorizontalAlignment="Stretch" />
    <TextBlock Text="每次调整都会记一笔流水，含金额、原因、操作人、时间" FontSize="13"
               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
