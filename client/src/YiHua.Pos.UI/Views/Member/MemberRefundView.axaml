<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             xmlns:input="clr-namespace:YiHua.Pos.UI.Controls.Input"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Member"
             x:Class="YiHua.Pos.UI.Views.Member.MemberRefundView"
             x:DataType="vm:MemberRefundViewModel">
  <StackPanel Spacing="12" MaxWidth="480" Margin="16">
    <TextBlock Text="退卡" FontSize="20" FontWeight="Bold" />
    <TextBlock Text="{Binding Member.Balance, StringFormat='卡内余额 ¥{0:F2}'}"
               FontSize="18" />

    <TextBlock Text="姓名（留存，法规要求）" FontSize="14" />
    <input:TouchTextBox Text="{Binding Name}" Watermark="持卡人姓名" />

    <TextBlock Text="证件号（留存，法规要求）" FontSize="14" />
    <input:TouchTextBox Text="{Binding IdCardNo}" Watermark="身份证号" />

    <TextBlock Text="退款方式" FontSize="14" />
    <ComboBox SelectedIndex="0" MinHeight="48" HorizontalAlignment="Stretch">
      <ComboBoxItem>现金（余额 &lt; 100 元）</ComboBoxItem>
      <ComboBoxItem>银行转账</ComboBoxItem>
    </ComboBox>

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
               FontSize="14" TextWrapping="Wrap" />
    <btn:PosButton Content="申请退卡" Variant="Danger" MinHeight="52" HorizontalAlignment="Stretch" />
    <TextBlock Text="退卡后余额清零，消费记录保留。需要二次确认。"
               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
