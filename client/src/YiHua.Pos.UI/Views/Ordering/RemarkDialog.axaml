<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Ordering"
        x:Class="YiHua.Pos.UI.Views.Ordering.RemarkDialog"
        x:DataType="vm:RemarkViewModel"
        Title="备注"
        Width="440" Height="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
  <StackPanel Margin="24,20" Spacing="16">
    <TextBlock Text="{Binding ProductName}"
               FontSize="{DynamicResource FontSizeSubtitle}"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimaryBrush}" />
    <TextBox Text="{Binding Remark}"
             FontSize="{DynamicResource FontSizeBody}"
             MinHeight="120"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             Watermark="输入备注（最多30字），如：不要葱" />
    <TextBlock Text="{Binding RemainChars, StringFormat='还可输入 {0} 字'}"
               FontSize="{DynamicResource FontSizeSmall}"
               Foreground="{DynamicResource TextSecondaryBrush}"
               HorizontalAlignment="Right" />
    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
      <Button Content="取消" MinWidth="110" MinHeight="52" />
      <Button Content="确定" MinWidth="110" MinHeight="52" />
    </StackPanel>
  </StackPanel>
</Window>
