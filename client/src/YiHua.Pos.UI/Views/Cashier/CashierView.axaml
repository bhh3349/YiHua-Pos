<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             xmlns:cards="clr-namespace:YiHua.Pos.UI.Controls.Cards"
             xmlns:input="clr-namespace:YiHua.Pos.UI.Controls.Input"
             xmlns:lists="clr-namespace:YiHua.Pos.UI.Controls.Lists"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Ordering"
             x:Class="YiHua.Pos.UI.Views.Cashier.CashierView"
             x:DataType="vm:OrderEntryViewModel">
  <!--
    收银主界面。布局对齐参考端实测结构：
      左 415px 购物车 │ 中 103px 操作条 │ 右 商品区（自适应）
      购物车底部是支付方式（不是单独一页）
    所有动作同屏完成：点菜、改量、备注、打折、收款，没有页面跳转。
  -->
  <Grid RowDefinitions="Auto,*">

    <!-- 顶栏 -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
            Padding="12,8">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="12">
        <!-- 堂食 / 外带 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <RadioButton x:Name="DineInRadio" Content="堂食" GroupName="foodType"
                       IsChecked="True" Click="OnDineIn" MinHeight="36" />
          <RadioButton x:Name="TakeOutRadio" Content="外带" GroupName="foodType"
                       Click="OnTakeOut" MinHeight="36" />
        </StackPanel>

        <!-- 桌台 / 快餐 -->
        <TextBlock Grid.Column="1" x:Name="DeskLabel" VerticalAlignment="Center"
                   FontSize="16" FontWeight="SemiBold" />

        <!-- 制作中计数 -->
        <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}"
                CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
          <TextBlock x:Name="KitchenLabel" FontSize="13"
                     Foreground="{DynamicResource TextSecondaryBrush}" Text="制作中：0 份 / 0 单" />
        </Border>

        <!-- 搜索 -->
        <input:TouchTextBox Grid.Column="3" x:Name="SearchBox"
                            Watermark="菜品名称 / 首字母" MinHeight="38"
                            MaxWidth="320" HorizontalAlignment="Left"
                            TextChanged="OnSearchChanged" />

        <!-- 快捷图标 -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <btn:PosButton Content="挂单" Variant="Secondary" Click="OnHang" MinHeight="36" MinWidth="72" />
          <btn:PosButton Content="订单" Variant="Secondary" Click="OnOpenOrders" MinHeight="36" MinWidth="72" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 三栏主体 -->
    <Grid Grid.Row="1" ColumnDefinitions="415,118,*">

      <!-- 左：购物车 -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto"
            Background="{DynamicResource SurfaceBrush}">
        <!-- 车头：餐牌号 / 登录会员 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="10,10,10,6">
          <btn:PosButton Grid.Column="0" Content="餐牌号" Variant="Secondary"
                         Click="OnTicketNo" MinHeight="44" MinWidth="86" />
          <btn:PosButton Grid.Column="1" x:Name="MemberButton" Content="登录会员" Variant="Secondary"
                         Click="OnMember" MinHeight="44" MinWidth="110" />
          <TextBlock Grid.Column="2" x:Name="TicketNoLabel" VerticalAlignment="Center"
                     HorizontalAlignment="Right" FontSize="14"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>

        <!-- 明细 -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,0">
          <Panel>
            <ListBox x:Name="LineList"
                     ItemsSource="{Binding Lines}"
                     SelectedItem="{Binding SelectedLine}"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OrderLineViewModel">
                  <lists:OrderItemRow ProductName="{Binding ProductName}"
                                      SpecText="{Binding SpecText}"
                                      Quantity="{Binding Qty}"
                                      UnitPrice="{Binding Price}" Tag="{Binding}"
                                      IsGift="{Binding IsGift}"
                                      IsRefunded="{Binding IsRefunded}"
                                      IsWeighted="{Binding IsWeighted}"
                                      DisplayQty="{Binding DisplayQty}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空车：问候语而不是空白（参考端同款处理） -->
            <StackPanel x:Name="EmptyCart" IsVisible="True"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
              <TextBlock x:Name="GreetingText" FontSize="22" FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock x:Name="DateText" FontSize="13"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="点右边的菜开始下单" FontSize="13" Margin="0,8,0,0"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Panel>
        </ScrollViewer>

        <!-- 合计 + 支付方式（参考端把收款放在车底部） -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="10">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="合计" FontSize="14"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" x:Name="TotalLabel"
                         FontSize="26" FontWeight="Bold" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" x:Name="DiscountLabel" FontSize="12"
                         Foreground="{DynamicResource DangerBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="CountLabel" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>

            <!-- 支付方式：直接开结账，不再跳页 -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
              <btn:PosButton Grid.Column="0" Content="现金支付" Variant="Primary"
                             Click="OnPayCash" MinHeight="52" />
              <btn:PosButton Grid.Column="1" Content="扫码收款" Variant="Primary"
                             Click="OnPayQr" MinHeight="52" />
              <btn:PosButton Grid.Column="2" Content="更多支付" Variant="Secondary"
                             Click="OnPayMore" MinHeight="52" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 中：操作条 -->
      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0">
      <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,10,0,0">
          <Button Content="−" Click="OnLineDecrease" x:Name="QtyMinus"
                  MinHeight="38" Margin="12,0" FontSize="20"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <TextBlock x:Name="QtyLabel" Text="0" FontSize="18" FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <Button Content="＋" Click="OnLineIncrease" x:Name="QtyPlus"
                  MinHeight="38" Margin="12,0" FontSize="20"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
          <StackPanel x:Name="OpStack" Spacing="6" Margin="8,0,8,12">
            <btn:PosButton Content="规格/做法" Variant="Secondary" Click="OnSpec" Tag="line" MinHeight="42" FontSize="13" />
            <btn:PosButton Content="加料" Variant="Secondary" Click="OnIngredient" Tag="line" MinHeight="42" FontSize="13" />
            <btn:PosButton Content="修改单价" Variant="Secondary" Click="OnEditPrice" Tag="line" MinHeight="42" FontSize="13" />
            <btn:PosButton Content="打折/减免" Variant="Secondary" Click="OnLineDiscount" Tag="line" MinHeight="42" FontSize="13" />
            <btn:PosButton Content="赠菜" Variant="Secondary" Click="OnGift" Tag="line" MinHeight="42" FontSize="13" />
            <btn:PosButton Content="清空" Variant="Secondary" Click="OnClearCart" MinHeight="42" FontSize="13" />
            <btn:PosButton Content="删除" Variant="Danger" Click="OnDeleteLine" MinHeight="42" FontSize="13" />
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,2" />
            <btn:PosButton Content="取单" Variant="Secondary" Click="OnTakeOrder" MinHeight="42" FontSize="13" />
            <btn:PosButton Content="打包" Variant="Secondary" Click="OnPack" MinHeight="42" FontSize="13" />
            <btn:PosButton Content="单品备注" Variant="Secondary" Click="OnLineRemark" Tag="line" MinHeight="42" FontSize="13" />
            <btn:PosButton Content="整单备注" Variant="Secondary" Click="OnOrderRemark" MinHeight="42" FontSize="13" />
            <btn:PosButton Content="开钱箱" Variant="Secondary" Click="OnOpenDrawer" MinHeight="42" FontSize="13" />
            <btn:PosButton Content="整单打折" Variant="Secondary" Click="OnOrderDiscount" MinHeight="42" FontSize="13" />
            <btn:PosButton Content="抹零" Variant="Secondary" Click="OnWipeZero" MinHeight="42" FontSize="13" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      </Border>

      <!-- 右：商品区 -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="12,10,12,10">
        <!-- 分类标签 -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
          <StackPanel x:Name="CategoryTabs" Orientation="Horizontal" Spacing="8" />
        </ScrollViewer>

        <!-- 商品网格 -->
        <ScrollViewer Grid.Row="1">
          <Panel>
            <ItemsControl x:Name="ProductGrid">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel x:Name="EmptyProducts" IsVisible="False"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
              <TextBlock Text="还没有菜品" FontSize="20" FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="到「菜品」页加第一道菜" FontSize="13"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Panel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>