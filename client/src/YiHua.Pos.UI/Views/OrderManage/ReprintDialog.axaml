<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.OrderManage"
             x:Class="YiHua.Pos.UI.Views.OrderManage.ReprintDialog"
             x:DataType="vm:ReprintViewModel">
  <StackPanel Spacing="16" Margin="24">
    <TextBlock Text="{Binding Order.OrderNo, StringFormat='重打 · {0}'}"
               FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" />
    <TextBlock Text="重打不改变订单状态"
               Foreground="{DynamicResource TextSecondaryBrush}" />
    <StackPanel Spacing="8">
      <TextBlock Text="打印类型" Foreground="{DynamicResource TextSecondaryBrush}" />
      <ComboBox x:Name="TypeCombo" MinHeight="44"
                SelectionChanged="OnTypeChanged">
        <ComboBoxItem Content="小票" IsSelected="True" />
        <ComboBoxItem Content="后厨单" />
        <ComboBoxItem Content="交班单" />
      </ComboBox>
    </StackPanel>
    <TextBlock Text="{Binding ErrorMessage}"
               IsVisible="{Binding !!ErrorMessage}"
               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="取消" Click="OnCancel" MinHeight="48" MinWidth="120" />
      <Button Content="确认重打" Click="OnConfirm" MinHeight="48" MinWidth="120" />
    </StackPanel>
  </StackPanel>
</UserControl>
