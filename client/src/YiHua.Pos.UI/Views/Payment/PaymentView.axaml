<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             xmlns:input="clr-namespace:YiHua.Pos.UI.Controls.Input"
             xmlns:disp="clr-namespace:YiHua.Pos.UI.Controls.Display"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Payment"
             x:Class="YiHua.Pos.UI.Views.Payment.PaymentView"
             x:DataType="vm:PaymentViewModel">
  <Grid ColumnDefinitions="5.5*,4.5*">

    <!-- ===== 左：订单明细（只读，核对用）===== -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
              Padding="16,12">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding DeskInfo}" FontSize="{DynamicResource FontSizeTitle}"
                     FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding OrderNo, StringFormat='单号 {0}'}"
                     FontSize="{DynamicResource FontSizeSmall}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" Padding="16,12">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PaymentOrderItemDto">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,6">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{Binding ProductName}" FontSize="{DynamicResource FontSizeBody}" />
                  <TextBlock Text="{Binding SpecText}" FontSize="{DynamicResource FontSizeSmall}"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='×{0}'}"
                           FontSize="{DynamicResource FontSizeBody}"
                           VerticalAlignment="Center" MinWidth="44" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='¥{0:F2}'}"
                           FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                           VerticalAlignment="Center" MinWidth="86" TextAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 金额区：应收最大字号 -->
      <Border Grid.Row="2" Background="{DynamicResource BackgroundBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
              Padding="16,12">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="原价"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalAmount, StringFormat='¥{0:F2}'}"
                     HorizontalAlignment="Right" MinWidth="120" TextAlignment="Right" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="优惠"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                      HorizontalAlignment="Right" Spacing="6">
            <TextBlock Text="{Binding DiscountLabel}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DiscountAmount, StringFormat='-¥{0:F2}'}"
                       Foreground="{DynamicResource DangerBrush}"
                       MinWidth="90" TextAlignment="Right" />
          </StackPanel>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="应收"
                     FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,6,0,0" />
          <TextBlock Grid.Row="2" Grid.Column="1"
                     Text="{Binding PayableAmount, StringFormat='¥{0:F2}'}"
                     FontSize="32" FontWeight="Bold" HorizontalAlignment="Right"
                     Margin="0,6,0,0" />
        </Grid>
      </Border>
    </Grid>

    <!-- ===== 右：优惠 + 支付方式 + 实收 ===== -->
    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
      <ScrollViewer Padding="16,12">
        <StackPanel Spacing="14">

          <!-- 整单优惠 -->
          <TextBlock Text="整单优惠" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <btn:PosButton Grid.Column="0" Content="抹分" Variant="Secondary"
                           Click="OnRoundToJiao" MinHeight="48" />
            <btn:PosButton Grid.Column="1" Content="抹角" Variant="Secondary"
                           Click="OnRoundToYuan" MinHeight="48" />
            <btn:PosButton Grid.Column="2" Content="打折" Variant="Secondary"
                           Click="OnRateDiscount" MinHeight="48" />
          </Grid>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <btn:PosButton Grid.Column="0" Content="减免" Variant="Secondary"
                           Click="OnFixedDiscount" MinHeight="48" />
            <btn:PosButton Grid.Column="1" Content="改价" Variant="Secondary"
                           Click="OnOverridePrice" MinHeight="48" />
            <btn:PosButton Grid.Column="2" Content="免单" Variant="Danger"
                           Click="OnFreeOrder" MinHeight="48" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <input:TouchTextBox Grid.Column="0" x:Name="DiscountValueBox"
                                Watermark="折扣值：9折填 0.9 / 减免填金额" />
            <btn:PosButton Grid.Column="1" Content="清除优惠" Variant="Secondary"
                           Click="OnClearDiscount" MinWidth="110" />
          </Grid>
          <TextBlock x:Name="DiscountErrorText" Foreground="{DynamicResource DangerBrush}"
                     FontSize="14" TextWrapping="Wrap" />

          <!-- 支付方式 -->
          <TextBlock Text="支付方式" FontSize="{DynamicResource FontSizeSubtitle}"
                     FontWeight="SemiBold" Margin="0,6,0,0" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <btn:PosButton Grid.Column="0" x:Name="MethodCash" Content="现金"
                           Click="OnSelectCash" MinHeight="56" FontSize="18" />
            <btn:PosButton Grid.Column="1" x:Name="MethodCustomQr" Content="自定义收款"
                           Click="OnSelectCustomQr" MinHeight="56" FontSize="18" />
            <btn:PosButton Grid.Column="2" x:Name="MethodCredit" Content="挂账"
                           Click="OnSelectCredit" MinHeight="56" FontSize="18" />
          </Grid>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <btn:PosButton Grid.Column="0" x:Name="MethodMember" Content="会员卡"
                           Click="OnSelectMember" MinHeight="56" FontSize="18" />
            <btn:PosButton Grid.Column="1" x:Name="MethodGroupBuy" Content="团购券"
                           Click="OnSelectGroupBuy" MinHeight="56" FontSize="18" />
            <Border Grid.Column="2" />
          </Grid>

          <!-- 实收（现金才需要填） -->
          <StackPanel x:Name="CashPanel" Spacing="8">
            <TextBlock Text="实收金额" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <input:TouchTextBox Grid.Column="0" x:Name="ReceivedBox" Watermark="收到的现金" TextChanged="OnReceivedChanged" />
              <btn:PosButton Grid.Column="1" Content="正好" Variant="Secondary"
                             Click="OnExactAmount" MinWidth="90" />
            </Grid>
            <ItemsControl x:Name="QuickAmountList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:Decimal">
                  <Button Content="{Binding StringFormat='¥{0:F0}'}"
                          Click="OnQuickAmount"
                          Tag="{Binding}"
                          MinWidth="76" MinHeight="44" Margin="0,0,8,8"
                          Background="{DynamicResource BackgroundBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="6" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- 找零：全屏唯一大字号强调 -->
          <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="10" Padding="16">
            <StackPanel>
              <TextBlock Text="找零" FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{Binding ChangeAmount, StringFormat='¥{0:F2}'}"
                         FontSize="40" FontWeight="Bold"
                         Foreground="{DynamicResource PrimaryBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                     FontSize="14" TextWrapping="Wrap" />

          <btn:PosButton Content="确认结账" Variant="Primary"
                         Click="OnConfirmSettle"
                         MinHeight="64" FontSize="20"
                         HorizontalAlignment="Stretch" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>