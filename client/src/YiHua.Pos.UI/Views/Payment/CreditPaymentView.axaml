<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             xmlns:input="clr-namespace:YiHua.Pos.UI.Controls.Input"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Payment"
             x:Class="YiHua.Pos.UI.Views.Payment.CreditPaymentView"
             x:DataType="vm:CreditPaymentViewModel">
  <StackPanel Spacing="12" Margin="16">
    <TextBlock Text="{Binding PayableAmount, StringFormat='挂账金额 ¥{0:F2}'}"
               FontSize="24" FontWeight="Bold" />
    <TextBlock Text="选择客户" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" />
    <btn:PosButton Content="选择客户…" Variant="Secondary" HorizontalAlignment="Stretch" MinHeight="56" />
    <TextBlock Text="{Binding SelectedCustomer.Name, StringFormat='客户：{0}'}"
               FontSize="16" />
    <TextBlock Text="或新建临时客户" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
    <input:TouchTextBox Watermark="客户名称" />
    <input:TouchTextBox Watermark="电话（选填）" />
    <TextBlock Text="{Binding Validate}" Foreground="{DynamicResource DangerBrush}" FontSize="14" />
    <TextBlock Text="记账说明：普通收银员有额度上限，超限需店长授权"
               FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
