<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             xmlns:disp="clr-namespace:YiHua.Pos.UI.Controls.Display"
             x:Class="YiHua.Pos.UI.Views.Payment.PaymentResultView">
  <StackPanel Spacing="16" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="400">
    <TextBlock Text="结账成功" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
    <!-- 找零：最醒目 -->
    <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="10" Padding="24">
      <StackPanel>
        <TextBlock Text="找零" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="ChangeText" Text="¥26.00" FontSize="48" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryBrush}"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
    <disp:KeyValueRow Key="实收" Value="¥100.00" />
    <disp:KeyValueRow Key="应收" Value="¥74.00" />
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
      <btn:PosButton Grid.Column="0" Content="继续开台" Variant="Secondary" />
      <btn:PosButton Grid.Column="1" Content="打印小票" Variant="Secondary" />
      <btn:PosButton Grid.Column="2" Content="返回桌台" Variant="Primary" />
    </Grid>
  </StackPanel>
</UserControl>
