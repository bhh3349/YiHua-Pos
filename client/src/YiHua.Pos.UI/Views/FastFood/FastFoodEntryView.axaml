<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.FastFood"
             xmlns:cards="clr-namespace:YiHua.Pos.UI.Controls.Cards"
             xmlns:lists="clr-namespace:YiHua.Pos.UI.Controls.Lists"
             xmlns:display="clr-namespace:YiHua.Pos.UI.Controls.Display"
             xmlns:buttons="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             xmlns:feedback="clr-namespace:YiHua.Pos.UI.Controls.Feedback"
             x:Class="YiHua.Pos.UI.Views.FastFood.FastFoodEntryView"
             x:DataType="vm:FastFoodEntryViewModel"
             Background="{DynamicResource BackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ===== 取号头：取号 · 人数 | 就餐方式 ===== -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="14,6">
            <TextBlock Text="{Binding OrderTitleText}"
                       FontSize="20" FontWeight="Bold" Foreground="White"/>
          </Border>
          <!-- 未取号提示 -->
          <buttons:PosButton Variant="Secondary" Content="取号"
                                   IsVisible="{Binding !HasTicket}"
                                   Click="OnIssueTicket"/>
        </StackPanel>

        <!-- 就餐方式三选一 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="就餐方式" FontSize="14"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     VerticalAlignment="Center"/>
          <buttons:PosButton Variant="Secondary" Content="堂食" Click="OnDineIn"/>
          <buttons:PosButton Variant="Secondary" Content="外带" Click="OnTakeAway"/>
          <buttons:PosButton Variant="Secondary" Content="配送" Click="OnDelivery"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== 主体：左商品 55% | 右明细 45% ===== -->
    <Grid Grid.Row="1" ColumnDefinitions="55*,45*">

      <!-- 左：商品区 -->
      <Border Grid.Column="0"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,1,0"
              Padding="12">
        <Grid RowDefinitions="Auto,*">
          <!-- 分类 -->
          <ItemsControl Grid.Row="0" ItemsSource="{Binding Categories}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <buttons:PosButton Variant="Secondary" Content="{Binding Name}"
                                         Tag="{Binding Id}"
                                         Click="OnCategoryClick"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 商品卡 -->
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Products}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <cards:ProductCard ProductName="{Binding Name}"
                                     Price="{Binding Price}"
                                     UnitName="{Binding UnitName}"
                                     Margin="6"
                                     Tag="{Binding}"
                                     PointerPressed="OnProductClick"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- 空状态 -->
          <feedback:EmptyState Grid.Row="1"
                               Title="暂无商品"
                               Description="请选择分类或等待商品数据加载"
                               IsVisible="{Binding !Products.Count}"/>
        </Grid>
      </Border>

      <!-- 右：明细区 -->
      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" Padding="12">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <TextBlock Grid.Row="0" Text="{Binding OrderTitleText}"
                     FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Margin="0,0,0,8"/>

          <!-- 明细列表（复用 T-303 明细行） -->
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Lines}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <lists:OrderItemRow ProductName="{Binding ProductName}"
                                    SpecText="{Binding SpecText}"
                                    Quantity="{Binding Qty}"
                                    UnitPrice="{Binding Price}"
                                    IsGift="{Binding IsGift}"
                                    IsRefunded="{Binding IsRefunded}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 合计 -->
          <Border Grid.Row="2"
                  BorderBrush="{DynamicResource DividerBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="0,8" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="合计" FontSize="16"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
              <display:AmountDisplay Grid.Column="1"
                                     Amount="{Binding Totals.Payable}"
                                     FontSize="28"/>
            </Grid>
          </Border>

          <!-- 未结账阻断提示 -->
          <Border Grid.Row="3"
                  Background="{DynamicResource WarningBrush}"
                  CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                  IsVisible="{Binding BlockWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding BlockWarning}"
                       FontSize="14" Foreground="White"
                       TextWrapping="Wrap"/>
          </Border>

          <!-- 点单完成（快餐高频动作，区别于正餐"结账"） -->
          <buttons:PosButton Variant="Primary" Grid.Row="4" Content="点单完成"
                                 FontSize="20" FontWeight="Bold"
                                 Padding="0,16"
                                 IsEnabled="{Binding HasLines}"
                                 Click="OnSubmit"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== 底栏：提交状态 ===== -->
    <Border Grid.Row="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,8"
            IsVisible="{Binding Submit.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Submit.ErrorMessage}"
                 FontSize="14"
                 Foreground="{DynamicResource DangerBrush}"/>
    </Border>
  </Grid>
</UserControl>
