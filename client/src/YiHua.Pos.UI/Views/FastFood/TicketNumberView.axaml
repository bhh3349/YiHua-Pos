<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.FastFood"
             xmlns:buttons="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             x:Class="YiHua.Pos.UI.Views.FastFood.TicketNumberView"
             x:DataType="vm:TicketQueueStateMachine"
             Background="{DynamicResource SurfaceBrush}">
  <Border BorderBrush="{DynamicResource DividerBrush}"
          BorderThickness="0,0,0,1"
          Padding="16,10">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

      <!-- 当前叫号 -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="快餐模式"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center"/>
        <Border Background="{DynamicResource PrimaryBrush}"
                CornerRadius="6" Padding="16,6">
          <TextBlock Text="{Binding CurrentNumber}"
                     FontSize="28" FontWeight="Bold"
                     Foreground="White"
                     VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding CurrentStatusText}"
                   FontSize="14"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"/>
        <TextBlock VerticalAlignment="Center">
          <Run Text="等待 " FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <Run Text="{Binding WaitingCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Run Text=" 人" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </TextBlock>
      </StackPanel>

      <!-- 等待队列预览 -->
      <ItemsControl Grid.Column="1"
                    ItemsSource="{Binding WaitingNumbers}"
                    VerticalAlignment="Center"
                    Margin="16,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10,4">
              <TextBlock Text="{Binding}" FontSize="16"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 操作按钮 -->
      <buttons:PosButton Variant="Primary" Grid.Column="2" Content="叫下一号"
                             Margin="8,0" Padding="20,10" FontSize="16"
                             Click="OnCallNext"/>
      <buttons:PosButton Variant="Secondary" Grid.Column="3" Content="发号"
                               Margin="8,0" Padding="20,10" FontSize="16"
                               Click="OnIssue"/>
      <buttons:PosButton Variant="Secondary" Grid.Column="4" Content="叫号屏"
                           Margin="8,0" Padding="16,10"
                           Click="OnShowCallBoard"/>
    </Grid>
  </Border>
</UserControl>
