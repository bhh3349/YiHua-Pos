<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Desk"
             x:Class="YiHua.Pos.UI.Views.Desk.DeskChangeDialog"
             x:DataType="vm:DeskChangeViewModel">
  <StackPanel Spacing="16" Margin="24">
    <TextBlock Text="{Binding SourceDesk.Name, StringFormat='换台 · 源桌 {0}'}"
               FontSize="{DynamicResource FontSizeTitle}"
               FontWeight="Bold" />
    <TextBlock Text="选择目标空桌（明细将全部搬移）"
               Foreground="{DynamicResource TextSecondaryBrush}" />
    <ComboBox ItemsSource="{Binding AvailableTargets}"
              SelectedItem="{Binding TargetDesk}"
              MinHeight="44" MinWidth="200"
              PlaceholderText="选择目标桌">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Name}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="{Binding ErrorMessage}"
               IsVisible="{Binding !!ErrorMessage}"
               Foreground="{DynamicResource DangerBrush}"
               TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="取消" Click="OnCancel" MinHeight="48" MinWidth="120" />
      <Button Content="确认换台" Click="OnConfirm" MinHeight="48" MinWidth="120" />
    </StackPanel>
  </StackPanel>
</UserControl>
