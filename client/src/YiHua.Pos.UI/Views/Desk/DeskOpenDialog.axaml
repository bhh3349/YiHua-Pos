<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Desk"
        x:Class="YiHua.Pos.UI.Views.Desk.DeskOpenDialog"
        x:DataType="vm:DeskOpenViewModel"
        Title="开台"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
  <StackPanel Spacing="16" Margin="24">
    <TextBlock Text="{Binding Desk.Name, StringFormat='开台 · {0}'}"
               FontSize="{DynamicResource FontSizeTitle}"
               FontWeight="Bold" />
    <StackPanel Spacing="8">
      <TextBlock Text="就餐人数" Foreground="{DynamicResource TextSecondaryBrush}" />
      <NumericUpDown Value="{Binding GuestCount}"
                     Minimum="1" Maximum="99"
                     MinHeight="44" />
    </StackPanel>
    <TextBlock Text="{Binding ErrorMessage}"
               IsVisible="{Binding !!ErrorMessage}"
               Foreground="{DynamicResource DangerBrush}"
               TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="取消" Click="OnCancel" MinHeight="48" MinWidth="120" />
      <Button Content="确认开台" Click="OnConfirm" MinHeight="48" MinWidth="120" />
    </StackPanel>
  </StackPanel>
</Window>