<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Report"
             xmlns:svc="clr-namespace:YiHua.Pos.UI.Services.Report"
             x:Class="YiHua.Pos.UI.Views.Report.ReportProductRankView"
             x:DataType="vm:ReportProductRankViewModel">
  <Grid RowDefinitions="Auto,*" Margin="16">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="菜品排行" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
      <btn:PosButton Content="按销售额" Variant="Primary" />
      <btn:PosButton Content="按销量" Variant="Secondary" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Items}" MaxWidth="800">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="svc:RankItem">
            <Border Padding="12,10" Margin="0,0,0,4" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <Grid ColumnDefinitions="40,*,80,100,60" ColumnSpacing="8">
                <TextBlock Text="{Binding Rank}" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                  <ProgressBar Value="{Binding Share}" Maximum="1" Height="8"
                               Foreground="{DynamicResource PrimaryBrush}"
                               Background="{DynamicResource DividerBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='{}{0:F0} 份'}"
                           FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat='¥{0:F2}'}"
                           FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{Binding Share, StringFormat='{}{0:P0}'}"
                           FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
