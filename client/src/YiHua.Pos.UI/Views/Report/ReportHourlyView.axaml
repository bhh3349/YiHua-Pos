<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Report"
             xmlns:svc="clr-namespace:YiHua.Pos.UI.Services.Report"
             x:Class="YiHua.Pos.UI.Views.Report.ReportHourlyView"
             x:DataType="vm:ReportHourlyViewModel">
  <ScrollViewer Margin="16">
    <StackPanel Spacing="8" MaxWidth="800">
      <TextBlock Text="{Binding ReportDate, StringFormat='{}{0:yyyy-MM-dd} 时段分析'}"
                 FontSize="20" FontWeight="Bold" />
      <TextBlock Text="{Binding PeakLabel}" FontSize="16"
                 Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />

      <!-- 按小时条形（横向），高峰时段加粗标注 -->
      <ItemsControl ItemsSource="{Binding Buckets}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="svc:HourBucket">
            <Grid ColumnDefinitions="50,*,90" ColumnSpacing="8" Margin="0,3,0,3">
              <TextBlock Text="{Binding Hour, StringFormat='{}{0}点'}" FontSize="14"
                         VerticalAlignment="Center" />
              <ProgressBar Value="{Binding BarRatio}" Maximum="1"
                           Height="18" Foreground="{DynamicResource PrimaryBrush}"
                           Background="{DynamicResource DividerBrush}" />
              <TextBlock Grid.Column="2" Text="{Binding Turnover, StringFormat='¥{0:F0}'}"
                         FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="高峰时段用于决定备货和排班" FontSize="14"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
