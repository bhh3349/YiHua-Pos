<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:disp="clr-namespace:YiHua.Pos.UI.Controls.Display"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Report"
             x:Class="YiHua.Pos.UI.Views.Report.ReportHomeView"
             x:DataType="vm:ReportHomeViewModel">
  <ScrollViewer Margin="16">
    <StackPanel Spacing="16" MaxWidth="800">
      <!-- 日期标题 -->
      <TextBlock Text="{Binding ReportDate, StringFormat='{}{0:yyyy-MM-dd}（今天）'}"
                 FontSize="20" FontWeight="Bold" />

      <!-- 核心指标 -->
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="营业额" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding Turnover, StringFormat='¥{0:F2}'}"
                       FontSize="28" FontWeight="Bold" />
            <TextBlock Text="{Binding TurnoverGrowth, StringFormat='较昨日 {0:P1}'}" FontSize="14" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="订单数" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding OrderCount, StringFormat='{}{0} 笔'}"
                       FontSize="28" FontWeight="Bold" />
            <TextBlock Text="{Binding OrderCountGrowth, StringFormat='较昨日 {0:P1}'}" FontSize="14" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="客单价" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding AvgTicket, StringFormat='¥{0:F2}'}"
                       FontSize="28" FontWeight="Bold" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- 优惠/实收 -->
      <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="16">
        <StackPanel Spacing="8">
          <disp:KeyValueRow Key="优惠金额" Value="{Binding DiscountTotal, StringFormat='¥{0:F2}'}" />
          <disp:KeyValueRow Key="实收" Value="{Binding NetReceived, StringFormat='¥{0:F2}'}" IsAmount="True" />
        </StackPanel>
      </Border>

      <!-- 支付方式分布（条形图，不用饼图） -->
      <TextBlock Text="支付方式" FontSize="16" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding PayTypeBreakdown}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PayTypeShareDto">
            <Grid ColumnDefinitions="80,*,90" ColumnSpacing="8" Margin="0,6,0,6">
              <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" />
              <ProgressBar Value="{Binding Share}" Maximum="1" Height="20"
                           Foreground="{DynamicResource PrimaryBrush}"
                           Background="{DynamicResource DividerBrush}" />
              <TextBlock Grid.Column="2"
                         Text="{Binding Amount, StringFormat='¥{0:F0}'}"
                         FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 订单类型分布 -->
      <TextBlock Text="订单类型" FontSize="16" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding OrderTypeBreakdown}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OrderTypeShareDto">
            <disp:KeyValueRow Key="{Binding Name}" Value="{Binding Amount, StringFormat='¥{0:F2}'}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
