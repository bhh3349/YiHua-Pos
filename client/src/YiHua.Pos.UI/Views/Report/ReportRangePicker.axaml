<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:btn="clr-namespace:YiHua.Pos.UI.Controls.Buttons"
             xmlns:vm="clr-namespace:YiHua.Pos.UI.ViewModels.Report"
             x:Class="YiHua.Pos.UI.Views.Report.ReportRangePicker"
             x:DataType="vm:ReportRangeViewModel">
  <StackPanel Spacing="12" MinWidth="300">
    <TextBlock Text="日期范围" FontSize="18" FontWeight="Bold" />
    <WrapPanel Orientation="Horizontal">
      <btn:PosButton Content="今天" Variant="Secondary" Margin="0,0,8,8" />
      <btn:PosButton Content="昨天" Variant="Secondary" Margin="0,0,8,8" />
      <btn:PosButton Content="本周" Variant="Secondary" Margin="0,0,8,8" />
      <btn:PosButton Content="本月" Variant="Secondary" Margin="0,0,8,8" />
      <btn:PosButton Content="自定义" Variant="Secondary" Margin="0,0,8,8" />
    </WrapPanel>
    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
      <CalendarDatePicker Grid.Column="0" />
      <TextBlock Grid.Column="1" Text="至" VerticalAlignment="Center" />
      <CalendarDatePicker Grid.Column="2" />
    </Grid>
    <TextBlock Text="自定义范围最多 90 天" FontSize="14"
               Foreground="{DynamicResource TextSecondaryBrush}" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <btn:PosButton Grid.Column="0" Content="取消" Variant="Secondary" />
      <btn:PosButton Grid.Column="1" Content="确定" Variant="Primary" />
    </Grid>
  </StackPanel>
</UserControl>
