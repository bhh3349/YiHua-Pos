# 统一换行符，避免跨平台协作时的噪音 diff
* text=auto eol=lf

# Windows 专用脚本保持 CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Linux 脚本必须 LF —— 带 CRLF 会在 Linux 上报 "\r: command not found"
*.sh text eol=lf
*.service text eol=lf
*.rules text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.list text eol=lf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.dll binary
*.exe binary
*.so binary
*.db binary
*.img binary

# 语言统计
*.cs   linguist-language=C#
*.axaml linguist-language=XAML
