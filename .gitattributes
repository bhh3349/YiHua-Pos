# 统一换行符，避免跨平台协作时的噪音 diff
* text=auto eol=lf

# Windows 专用脚本保持 CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.dll binary
*.exe binary
*.so binary
*.db binary

# 语言统计
*.cs   linguist-language=C#
*.axaml linguist-language=XAML
