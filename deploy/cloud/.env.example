# 复制成 .env 后按需修改
#
# 【重要】CLIENT_API_BASE 决定客户端连哪个地址：
#   - 有域名+证书： https://pos.yourdomain.com
#   - 只有公网 IP： http://1.2.3.4          （无 TLS，客户端也支持）
#
# 注意：如果这里填「域名」，客户端会先走内置的阿里云 HTTPDNS 解析一次
#       （用的是原发行方的账号），再回落到系统 DNS。填「IP」则完全跳过 HTTPDNS。
#       想彻底避免，见 README 的「HTTPDNS 处理」一节。

MYSQL_ROOT_PASSWORD=change-root-pwd
MYSQL_DATABASE=pos
MYSQL_USER=pos
MYSQL_PASSWORD=change-pos-pwd

JWT_SECRET=change-this-to-a-long-random-string

CLIENT_API_BASE=http://127.0.0.1
